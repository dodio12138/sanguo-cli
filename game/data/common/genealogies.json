      "people": {
        "关羽之女（姓名未载）": {
          "biography": "孙权曾遣使为子向关羽求婚，关羽拒绝；正文未记其女姓名，不将后世称号当作本名。"
        },
        "蜀公主（关统妻）": {
          "biography": "关统所尚公主，正文未载姓名及父亲身份，不擅自连为刘备或刘禅之女。"
        },
        "关平": {
          "biography": "关羽之子，正文载父子俱被孙权军所杀。演义另有收义子叙事；本谱父子关系采用正文。"
        }
