      "people": {
        "刘雄": {
          "biography": "刘备祖父，举孝廉，官至东郡范令。先主传直载祖雄、父弘；不补从刘贞到刘雄之间失载的世系。"
        },
        "刘弘（刘备父）": {
          "biography": "刘备之父，先主传载刘氏世仕州郡，刘备少孤。与刘馥之孙、晋代将领刘弘不是同一人。卒年未载。"
        },
        "刘备之母（姓名未载）": {
          "biography": "刘备母亲，丈夫早亡，与刘备贩履织席；刘备十五岁时使其从卢植学习。原书未载姓名，不采用后世杜撰本名。"
        },
        "刘子敬": {
          "biography": "《先主传》称刘备叔父子敬，曾告诫刘备不要妄言乘羽葆盖车；子敬是否本名或字未详。"
        },
        "刘元起": {
          "biography": "刘德然之父，宗中长者，常资助刘备求学；不推定其与刘弘之间具体房系。"
        },
        "吴氏（穆皇后）": {
          "deathYear": 245,
          "biography": "陈留吴氏，吴懿之妹。先嫁刘瑁，寡居后嫁刘备，后为穆皇后；延熙八年卒。与游戏既有人物吴氏若无明确身份匹配，不强行合并。"
        },
        "张氏（敬哀皇后）": {
          "deathYear": 237,
          "biography": "张飞长女，刘禅第一任皇后。建兴十五年卒，谥敬哀。名未载；不以民间称名充作正史本名。"
        },
        "张氏（后主继后）": {
          "biography": "张飞次女，敬哀皇后之妹，后为刘禅继后。与姐姐分别建档，姓名未载。"
        },
        "王贵人（刘璿母）": {
          "biography": "刘禅贵人，原为敬哀张皇后的侍人，生太子刘璿。史书仅载姓王。"
        },
        "刘璿": {
          "birthYear": 224,
          "deathYear": 264,
          "debutYear": 238,
          "biography": "刘禅长子，字文衡，母王贵人。延熙元年立为太子，时年十五；按虚岁推生年224。264年钟会之乱遇害。"
        },
        "刘琮（刘禅子）": {
          "biography": "刘禅之子，见裴注《蜀世谱》，与刘表之子刘琮分开。"
        },
        "刘承（安平王）": {
          "deathYear": 257,
          "biography": "刘理之孙、刘胤之子，袭安平王，延熙二十年卒。与其他同名刘承分开。"
        },
        "刘玄（刘永孙）": {
          "biography": "刘永之孙，蜀亡后家系流散，后在蜀地被李雄署为安乐公；原书未载其父，不臆补一代。"
        }
      }
