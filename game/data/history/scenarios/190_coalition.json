  "schema_version":2,"id":"190_coalition","name":"洛阳","start_date":"190-01-01","map":"china_pixel_60x60","default_player_force":"cao","playable_forces":["dong","cao","yuan","sun_jian","gongsun","liu_biao","yuan_shu","han_fu","liu_yu","tao_qian","kong_rong","liu_yan","liu_dai","ma_teng","han_sui","gongsun_du","wang_kuang","kong_zhou","zhang_miao","qiao_mao","yuan_yi","bao_xin","zhang_chao","chen_wen","zhou_xin","liu_chong","shi_xie","jiao_he"],
  "description":"初平元年关东诸侯讨董；城市、关隘与渡津按扩展战略地图布置。",
  "historical_brief":"董卓控制洛阳朝廷与凉州、并州精兵；关东诸侯以讨董为名会盟，但粮运、号令与彼此猜忌将决定联军能否持续。",
  "force_briefs":{"dong":"掌握朝廷与洛阳，西凉、并州军是主要依仗；关东联军名义一致，实际各有盘算。","cao":"从陈留起兵，与张邈协同讨董；义军根基尚浅，须争取盟友与落脚点。","yuan":"四世三公、声望最盛，被推为盟主；需要把盟约变成真正的协同进军。","sun_jian":"以长沙太守身份北上从征，军纪与战力出众；眼下远离江东本土。","gongsun":"据幽州边郡，白马义从善战；刘虞主张怀柔，幽州内部并非铁板一块。","liu_biao":"受命镇抚荆州，坐拥江汉要冲；观察中原局势并处理地方豪强。","yuan_shu":"袁氏另一支，驻于南阳方向，兵势不弱却与袁绍存在宗族及权力竞争。","han_fu":"冀州牧，治所在邺；州郡富庶但个人威望不足，正受袁绍觊觎。","liu_yu":"幽州牧，主张安抚边民与乌桓；与公孙瓒的强硬路线相左。","tao_qian":"据徐州，须兼顾州内防务与北方战局。","kong_rong":"守北海一郡，文名高而兵力有限，周边强邻环伺。","liu_yan":"益州牧，倚仗蜀道和富庶盆地自成一方；汉中交通与地方豪强仍待经营。","liu_dai":"兖州刺史，与东郡、陈留等太守共同讨董；州内各郡仍有自己的部众。","ma_teng":"西凉军阀，骑兵见长；需应对关中动荡并争取向东发展的机会。","han_sui":"盘踞金城、安定一带，西北部众与马腾时盟时争。","gongsun_du":"辽东太守，在远东边地经营独立基业，暂不受关东主战场直接牵制。","wang_kuang":"河内太守，扼守黄河北岸，与关东诸军共同讨董。","kong_zhou":"豫州刺史，驻颍川参加讨董联盟。","zhang_miao":"陈留太守，与曹操交好，共举义兵讨董。","qiao_mao":"东郡太守，参加关东会盟，与刘岱各有部众。","yuan_yi":"山阳太守，以州郡兵参加关东讨董联盟。","bao_xin":"招募乡里义兵参加讨董，主张与曹操相互支援。","zhang_chao":"广陵太守，听从功曹臧洪建议，与兄张邈共举义兵。","chen_wen":"扬州刺史，掌理州部，在江淮维持地方秩序。","zhou_xin":"丹阳太守，曾援助曹操在扬州募集兵员。","liu_chong":"陈王，与国相骆俊保境安民，境内百姓依附。","shi_xie":"交趾太守，保境安民，接纳避乱士人。","jiao_he":"青州刺史，出兵参与讨董，同时面临州内黄巾扰乱。"},
  "objectives":{"dong":"守住洛阳朝廷与关中退路，分化讨董联盟","cao":"经营谯县义军据点，与陈留盟友协同讨董","yuan":"维系盟主威信，组织诸侯推进洛阳","sun_jian":"完成先锋作战并保存长沙北伐军","gongsun":"巩固幽州边防并处理与刘虞的路线分歧","liu_biao":"控制荆襄通道、维持州内稳定","yuan_shu":"守住南阳据点，压过袁氏宗族对手","han_fu":"保全冀州并抵御袁绍的政治与军事压力","liu_yu":"稳住幽州民政与边境，避免与公孙瓒内耗","tao_qian":"守住徐州门户，避免成为中原战场的牺牲品","kong_rong":"守护北海郡并借声望寻求盟援","liu_yan":"维系益州统一并控制入蜀要道","liu_dai":"守住兖州门户，避免被更强诸侯吞并","ma_teng":"维持凉州军力并开辟关中影响力","han_sui":"巩固金城—安定走廊并处理与马腾关系","gongsun_du":"确保辽东独立与北方边境安全","wang_kuang":"守住河内与黄河渡津，协助联军进军","kong_zhou":"稳定颍川与豫州州部，保障联军粮道","zhang_miao":"保全陈留，与曹操协同讨董","qiao_mao":"守住东郡渡津，维系诸侯盟约","yuan_yi":"守护山阳，兼顾会盟与郡内民生","bao_xin":"保全济北义兵，协助曹操勤王","zhang_chao":"稳住广陵，支援陈留同盟","chen_wen":"稳定江淮与江东，防止州郡失控","zhou_xin":"守住丹阳与江南通道，审慎援助关东诸军","liu_chong":"保全陈国，抵御外敌并接济流民","shi_xie":"守住交趾，维持民生与交通","jiao_he":"稳住青州州部，兼顾黄巾与关东战局"},
