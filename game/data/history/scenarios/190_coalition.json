{
  "schema_version":2,"id":"190_coalition","name":"反董卓联合","start_date":"190-01-01","map":"china_40x32","default_player_force":"cao","playable_forces":["dong","cao","yuan","sun_jian","gongsun","liu_biao","yuan_shu","han_fu","liu_yu","tao_qian","kong_rong","liu_yan","liu_dai","ma_teng","han_sui","gongsun_du"],
  "description":"初平元年关东诸侯讨董；城市、关隘与渡津按扩展战略地图布置。",
  "historical_brief":"董卓控制洛阳朝廷与凉州、并州精兵；关东诸侯以讨董为名会盟，但粮运、号令与彼此猜忌将决定联军能否持续。",
  "force_briefs":{"dong":"掌握朝廷与洛阳，西凉、并州军是主要依仗；关东联军名义一致，实际各有盘算。","cao":"从陈留起兵，根基尚浅而志在勤王；争取盟友、确保兖豫落脚点。","yuan":"四世三公、声望最盛，被推为盟主；需要把盟约变成真正的协同进军。","sun_jian":"以长沙太守身份北上从征，军纪与战力出众；眼下远离江东本土。","gongsun":"据幽州边郡，白马义从善战；刘虞主张怀柔，幽州内部并非铁板一块。","liu_biao":"受命镇抚荆州，坐拥江汉要冲；观察中原局势并处理地方豪强。","yuan_shu":"袁氏另一支，驻于南阳方向，兵势不弱却与袁绍存在宗族及权力竞争。","han_fu":"冀州牧，治所在邺；州郡富庶但个人威望不足，正受袁绍觊觎。","liu_yu":"幽州牧，主张安抚边民与乌桓；与公孙瓒的强硬路线相左。","tao_qian":"据徐州，须兼顾州内防务与北方战局。","kong_rong":"守北海一郡，文名高而兵力有限，周边强邻环伺。","liu_yan":"益州牧，倚仗蜀道和富庶盆地自成一方；汉中交通与地方豪强仍待经营。","liu_dai":"兖州刺史，立足濮阳周边；既要应对曹操与袁绍的扩张，也要防止州内失控。","ma_teng":"西凉军阀，骑兵见长；需应对关中动荡并争取向东发展的机会。","han_sui":"盘踞金城、安定一带，西北部众与马腾时盟时争。","gongsun_du":"辽东太守，在远东边地经营独立基业，暂不受关东主战场直接牵制。"},
  "objectives":{"dong":"守住洛阳朝廷与关中退路，分化讨董联盟","cao":"稳固陈留、争取盟友并建立自己的州郡根基","yuan":"维系盟主威信，组织诸侯推进洛阳","sun_jian":"完成先锋作战并保存长沙北伐军","gongsun":"巩固幽州边防并处理与刘虞的路线分歧","liu_biao":"控制荆襄通道、维持州内稳定","yuan_shu":"守住南阳据点，压过袁氏宗族对手","han_fu":"保全冀州并抵御袁绍的政治与军事压力","liu_yu":"稳住幽州民政与边境，避免与公孙瓒内耗","tao_qian":"守住徐州门户，避免成为中原战场的牺牲品","kong_rong":"守护北海郡并借声望寻求盟援","liu_yan":"维系益州统一并控制入蜀要道","liu_dai":"守住兖州门户，避免被更强诸侯吞并","ma_teng":"维持凉州军力并开辟关中影响力","han_sui":"巩固金城—安定走廊并处理与马腾关系","gongsun_du":"确保辽东独立与北方边境安全"},
